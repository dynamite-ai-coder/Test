# Telegram Bot Token (Control Bot - @Multi_url_bot)
TELEGRAM_BOT_TOKEN=

# Telegram API credentials (z https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Target bot username (bez @)
TARGET_BOT_USERNAME=

# Allowed Telegram user IDs (comma-separated)
ALLOWED_USER_IDS=

# Directories
DOWNLOAD_DIR=./downloads
RESULT_DIR=./results
DB_PATH=./data/queue.db

# Worker config
MAX_RETRIES=3
BOT_RESPONSE_TIMEOUT=60
FILE_TIMEOUT=180
MAX_FILE_SIZE=52428800
