{
  "$schema": "https://opencode.ai/config.json",
  "model": "groq/openai/gpt-oss-20b",
  "provider": {
    "groq": {
      "options": {
        "apiKey": "{env:GROQ_API_KEY}",
        "timeout": 60000
      },
      "models": {
        "openai/gpt-oss-20b": {
          "name": "GPT-OSS 20B",
          "limit": {
            "context": 4000,
            "output": 1000
          }
        },
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B",
          "limit": {
            "context": 4000,
            "output": 1000
          }
        },
        "qwen/qwen3.8-27b": {
          "name": "Qwen 3.8 27B",
          "limit": {
            "context": 4000,
            "output": 1000
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2,
    "reserved": 800,
    "preserve_recent_tokens": 1500
  }
}
